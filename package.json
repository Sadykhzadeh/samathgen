{
  "name": "samathgen",
  "version": "1.0.0",
  "description": "NPM library that generates math expressions for education purposes.",
  "type": "module",
  "main": "js/node.cjs",
  "types": "js/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./js/index.d.ts",
        "default": "./js/web.js"
      },
      "node": {
        "types": "./js/node.d.cts",
        "default": "./js/node.cjs"
      },
      "default": {
        "types": "./js/node.d.cts",
        "default": "./js/node.cjs"
      }
    }
  },
  "files": [
    "js",
    "dist",
    "Cargo.toml",
    "src",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "math",
    "generation",
    "expression",
    "generator",
    "wasm",
    "rust"
  ],
  "author": {
    "name": "Azer Sadykhzadeh",
    "url": "https://azer.is-a.dev"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://got.az/azer/samathgen.git"
  },
  "bugs": {
    "url": "https://got.az/azer/samathgen/issues"
  },
  "homepage": "https://samathgen.js.org/",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "cargo test --release && node test/contract.mjs",
    "test:rust": "cargo test --release",
    "test:js": "node test/contract.mjs",
    "bench": "node bench/throughput.mjs",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "wasm-pack": "^0.15.0"
  }
}
